NODE_ENV=development
PORT=8080

# Production deployments are read-only unless this is explicitly enabled.
PUBLIC_WRITE_ACCESS=false

# Development MongoDB connection string
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust_dev

# Generate a unique value of at least 32 characters
SECRET=replace-with-a-long-random-session-secret

# Use a separate development Cloudinary account/folder
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-api-key
CLOUD_API_SECRET=your-api-secret
