<% layout("layouts/boilerplate") %>
    <section class="listings-intro">
        <div>
            <p class="eyebrow"><%= isCuratedDemo ? "Curated portfolio data" : "Property catalogue" %></p>
            <h1><%= isCuratedDemo ? "Explore the public demo" : "Explore listings" %></h1>
            <p><%= isCuratedDemo
                ? "Six consistent sample records demonstrate search, catalogue and detail-page behaviour without exposing user-created data."
                : "Browse the latest listings or search by title, location or country." %></p>
        </div>
        <% if (isCuratedDemo) { %>
            <span class="demo-pill">Read-only sample catalogue</span>
        <% } %>
    </section>

    <% if (query) { %>
        <p class="search-summary">Results for “<%= query %>”</p>
    <% } %>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings) { %>
            <a href="/listings/<%= listing._id %>" class="listing-links">
                <div class="card col listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top listing-card-image" alt="<%= listing.title %>" loading="lazy">
                    <div class="card-img-overlay"></div>
                    <div class="card-body listing-card-body">
                        <h2><%= listing.title %></h2>
                        <p class="listing-location"><i class="fa-solid fa-location-dot"></i> <%= listing.location %></p>
                        <p class="listing-price">£<%= Number(listing.price).toLocaleString("en-GB") %> <span>/ sample night</span></p>
                    </div>
                </div>
            </a>
        <% } %>
    </div>

    <% if (allListings.length === 0) { %>
        <section class="empty-state">
            <h2>No sample listings found</h2>
            <p>Try a UK city such as London, Edinburgh, Brighton or Bath.</p>
            <a class="btn btn-dark" href="/listings">Clear search</a>
        </section>
    <% } %>
